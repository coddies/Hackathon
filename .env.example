# Database connection string for asyncpg (e.g. Supabase Postgres)
DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co
# Supabase service role key
SUPABASE_SERVICE_KEY=your-service-key
# Secret key for JWT signing
SECRET_KEY=your-secret-key
# Algorithm for JWT signing
ALGORITHM=HS256
# Expiration time for access tokens in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Expiration time for refresh tokens in days
REFRESH_TOKEN_EXPIRE_DAYS=7
# Expiration time for seat holds in minutes
HOLD_EXPIRY_MINUTES=15
# Expiration time for travel credits in days
TRAVEL_CREDIT_EXPIRY_DAYS=365
# Email provider (smtp or gmail_api)
EMAIL_PROVIDER=smtp
# SMTP Host (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
# SMTP Port
SMTP_PORT=587
# SMTP Username
SMTP_USERNAME=user@example.com
# SMTP Password
SMTP_PASSWORD=your-password
# From email address for SMTP
SMTP_FROM_EMAIL=noreply@example.com
# Path to JSON key file for Gmail API (if EMAIL_PROVIDER=gmail_api)
GMAIL_SERVICE_ACCOUNT_FILE=path/to/service_account.json
# Sender email for Gmail API
GMAIL_SENDER_EMAIL=sender@example.com
# Application environment (development, staging, production)
ENVIRONMENT=development
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
