      "parameters": {
        "operation": "executeQuery",
        "query": "WITH candidate AS (SELECT w.id FROM waitlist_entries w JOIN seat_inventory s ON s.flight_id=w.flight_id AND s.seat_class=w.seat_class JOIN flights f ON f.id=w.flight_id WHERE w.status='WAITING' AND f.status <> 'CANCELLED' AND s.available_seats >= w.passenger_count ORDER BY w.priority_score DESC,w.created_at ASC FOR UPDATE SKIP LOCKED LIMIT 1) UPDATE waitlist_entries w SET status='PROMOTED',promoted_at=NOW(),claim_expires_at=NOW()+INTERVAL '2 hours' FROM candidate c WHERE w.id=c.id RETURNING w.id AS waitlist_id,w.user_id,w.flight_id,w.claim_expires_at;",
        "options": {}
      },
