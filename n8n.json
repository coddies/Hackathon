      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT b.id AS booking_id, u.full_name, u.email, f.flight_number, f.origin, f.destination, f.departure_at\nFROM bookings b\nJOIN users u ON u.id = b.user_id\nJOIN flights f ON f.id = b.flight_id\nLEFT JOIN notification_logs n ON n.booking_id = b.id AND n.notification_type = 'CHECKIN_REMINDER'\nWHERE b.status = 'CONFIRMED' AND f.status <> 'CANCELLED'\nAND f.departure_at BETWEEN NOW() + INTERVAL '23 hours' AND NOW() + INTERVAL '25 hours'\nAND n.id IS NULL;",
        "options": {}
      },
