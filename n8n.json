    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT f.flight_number, f.origin, f.destination, COALESCE(SUM(si.total_seats),0) total_seats, COALESCE(SUM(si.booked_seats),0) booked_seats, COALESCE(SUM(b.total_amount),0) revenue FROM flights f LEFT JOIN seat_inventory si ON si.flight_id=f.id LEFT JOIN bookings b ON b.flight_id=f.id AND b.status='CONFIRMED' WHERE f.status <> 'CANCELLED' GROUP BY f.id, f.flight_number, f.origin, f.destination;",
