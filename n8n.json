    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst hour = now.getHours();\nconst minute = now.getMinutes();\nconst day = now.getDay();\nlet job_type = 'WAITLIST_PROMOTION';\nif (minute === 0 && hour === 9 && day === 1) job_type = 'WEEKLY_OPS_REPORT';\nelse if (minute === 0 && hour === 9) job_type = 'DAILY_OPS_REPORT';\nelse if (minute === 0 && hour === 8) job_type = 'REFUND_ESCALATION';\nelse if (minute === 0 && hour === 7) job_type = 'RECENT_FRAUD_SCAN';\nelse if (minute === 0 && hour === 6 && day === 0) job_type = 'HISTORICAL_FRAUD_REVIEW';\nelse if (minute === 0) job_type = 'CHECKIN_REMINDER';\nreturn [{json:{job_type,run_at:now.toISOString()}}];"
      },
